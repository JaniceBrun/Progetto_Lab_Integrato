aws_region           = "us-east-1"
availability_zone    = "us-east-1a"
project              = "its-lab"
environment          = "lab"
team_ssh_cidrs       = ["203.0.113.10/32"]
bootstrap_public_key = "ssh-ed25519 AAAA... chiave-pubblica"

instance_sizing = {
  waf = {
    instance_type = "t3.small"
    volume_gb     = 30
  }
  bastion = {
    instance_type = "t3.micro"
    volume_gb     = 10
  }
  app = {
    instance_type = "t3.small"
    volume_gb     = 20
  }
  wazuh = {
    instance_type = "t3.large"
    volume_gb     = 60
  }
}
